# ---------------------------------------------------------------------------
# quant_engine environment template. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------
# Operating mode. PAPER is the default and the fail-closed fallback.
PAPER_MODE=true
LIVE_TRADING_ENABLED=false
TESTNET_MODE=false
EXCHANGE=binance
# LIVE additionally requires this exact phrase AND a passed deployment gate (artifacts/deployment_gate.json):
#   I UNDERSTAND THIS TRADES REAL MONEY AND MAY LOSE ALL OF IT
LIVE_TRADING_ACKNOWLEDGEMENT=

# Exchange API credentials (TESTNET/LIVE only). Use least-privilege keys:
# trading permission only, IP-whitelisted, NO withdrawal permission. Never needed for PAPER.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSPHRASE=

# Storage
# DATABASE_URL=sqlite:////absolute/path/var/quant_engine.sqlite
# MARKET_DATA_DIR=/absolute/path/var/market_data

# Dashboard authentication. Generate the hash with:
#   python scripts/hash_password.py
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD_HASH=
# 64+ random hex chars, e.g. python -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_JWT_SECRET=
DASHBOARD_TOKEN_TTL_MINUTES=60
DASHBOARD_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Optional alert webhook (Slack/Discord-compatible JSON POST)
ALERT_WEBHOOK_URL=
INITIAL_PAPER_CAPITAL=100000
